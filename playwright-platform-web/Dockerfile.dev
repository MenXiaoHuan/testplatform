FROM node:20-alpine

# Development image used by docker compose; production builds use Dockerfile.
WORKDIR /workspace

EXPOSE 5173

# npm ci uses package-lock.json for reproducible installs in the dev container.
# 首次启动安装依赖；之后复用 node_modules volume，重启不必再等 npm ci。
CMD ["sh", "-c", "[ -x node_modules/.bin/vite ] || npm ci; npm run dev -- --host 0.0.0.0"]
