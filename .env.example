# ============================================================
# Test platform environment template
# Copy to .env and fill in the placeholders:
#   cp .env.example .env
# .env is gitignored. Never commit real credentials.
#
# Only secrets, deployment differences, and per-host tuning belong here.
# Application defaults, timeouts, cache, AI context live in application.yml.
# ============================================================

# ---------- Frontend / entry points ----------
PLATFORM_WEB_HOST_PORT=5173
PLATFORM_WEB_API_PROXY_TARGET=http://server:8080
PLATFORM_SERVER_HOST_PORT=8080
PLATFORM_MYSQL_HOST_PORT=4306
PLATFORM_REDIS_HOST_PORT=7379
PLATFORM_MINIO_API_HOST_PORT=10000
PLATFORM_MINIO_CONSOLE_HOST_PORT=10001

# ---------- MySQL ----------
PLATFORM_DB_NAME=playwright_platform
PLATFORM_DB_URL=jdbc:mysql://mysql:3306/playwright_platform?useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true&serverTimezone=UTC
PLATFORM_DB_USERNAME=root
PLATFORM_DB_PASSWORD=<your-db-password>

# ---------- Redis ----------
PLATFORM_REDIS_HOST=redis
PLATFORM_REDIS_PORT=6379
PLATFORM_REDIS_PASSWORD=<your-redis-password>

# ---------- MinIO ----------
PLATFORM_MINIO_ENDPOINT=http://minio:9000
# Browser-reachable URL. In production use something like
# https://test-platform.example.com/minio instead of localhost.
PLATFORM_MINIO_PUBLIC_ENDPOINT=http://localhost:10000
PLATFORM_MINIO_ACCESS_KEY=<your-minio-access-key>
PLATFORM_MINIO_SECRET_KEY=<your-minio-secret-key>
PLATFORM_STORAGE_BUCKET=qa-report

# ---------- Runner ----------
PLATFORM_RUNNER_WORKSPACE_ROOT=/runner-workspaces
# Absolute path on the Docker host. On Linux: /opt/testplatform/.runner-workspaces
PLATFORM_RUNNER_HOST_WORKSPACE_ROOT=<absolute-path-to-project>/.runner-workspaces
PLATFORM_RUNNER_DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.61.1-noble
PLATFORM_RUNNER_DOCKER_NETWORK=bridge
PLATFORM_RUNNER_DOCKER_MEMORY=2g
PLATFORM_RUNNER_DOCKER_CPUS=2
PLATFORM_RUNNER_DOCKER_CONTAINER_WORKSPACE_ROOT=/workspace/task

# ---------- AI ----------
PLATFORM_DEEPSEEK_API_KEY=<your-deepseek-api-key>
PLATFORM_DEEPSEEK_BASE_URL=https://api.deepseek.com
PLATFORM_DEEPSEEK_MODEL=deepseek-chat
PLATFORM_DEEPSEEK_TEMPERATURE=0.3
PLATFORM_AI_DAILY_LIMIT=50
PLATFORM_AI_MAX_CONCURRENT=4

# ---------- Patrol LLM agent ----------
# 巡页用例规划复用 PLATFORM_DEEPSEEK_*；视觉判定需单独配置 OpenAI 兼容的多模态模型。
# 留空时巡页仍可执行，但判定会降级为 DOM + 规则，报告标记 degraded。
PLATFORM_VISION_BASE_URL=
PLATFORM_VISION_API_KEY=
PLATFORM_VISION_MODEL=
PLATFORM_VISION_TIMEOUT_SECONDS=60
PLATFORM_PATROL_MAX_CONCURRENT=10
PLATFORM_PATROL_QUEUE_CAPACITY=100
# 流式模型调用：LLM_TIMEOUT_SECONDS 是两段数据之间的空闲上限（兜底卡死连接），
# LLM_MAX_CALL_SECONDS 是单次调用总时长上限；真正的停止由任务时长预算负责。
PLATFORM_PATROL_LLM_TIMEOUT_SECONDS=120
PLATFORM_PATROL_LLM_MAX_CALL_SECONDS=1800

# ---------- Task capacity / retention ----------
# With core < max, steady-state runs core tasks; set CORE = MAX to use max immediately.
PLATFORM_TASK_CORE_POOL_SIZE=2
PLATFORM_TASK_MAX_POOL_SIZE=4
PLATFORM_TASK_QUEUE_CAPACITY=50
# 0 = no automatic cleanup; set 90 in production if disk is limited.
PLATFORM_TASK_RETENTION_DAYS=0

# ---------- Production Docker socket ----------
# Linux: stat -c '%g' /var/run/docker.sock. Windows dev can ignore.
DOCKER_GID=999

# ---------- Private Git / Git LFS ----------
# Private repository tokens/keys are configured per repository in the UI.
# This path is only for SSH known_hosts on the server.
PLATFORM_GIT_KNOWN_HOSTS_PATH=
PLATFORM_GIT_SUBMODULES_ENABLED=false
PLATFORM_GIT_LFS_ENABLED=false

# ---------- Stage log tuning ----------
PLATFORM_RUNNER_MAX_TEST_LOG_BYTES=209715200

# Repository credential encryption key (32-byte base64). Required for private repositories.
PLATFORM_CREDENTIAL_KEY=<base64-32-bytes>
